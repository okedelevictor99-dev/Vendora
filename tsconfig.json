{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "backend",
    "outDir": "./dist",

    "baseUrl": "./backend",
    "paths": {
      "@/*": ["*"]
    },
    

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],

    "resolvePackageJsonExports": false,
    "resolvePackageJsonImports": false,
    "resolveJsonModule": false
  },
  "include": ["backend"],
  "exclude": ["dist"]
}